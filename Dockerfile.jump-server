# Dockerfile for Koyeb Jump Server with test_db_perf
# Creates a server with pre-built test_db_perf binary and quote server

# Stage 1: Build Go binary
FROM golang:1.25.3 AS go-builder
WORKDIR /build

# Install WebP development libraries for gen_test_images (requires CGO)
RUN apt-get update && \
    apt-get install -y \
    libwebp-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build test_db_perf binary (statically linked)
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -o /build/test_db_perf \
    ./cmd/test_db_perf

# Build rebuild_db binary (statically linked)
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -o /build/rebuild_db \
    ./cmd/rebuild_db

# Build gen_test_images binary (requires CGO for WebP support)
RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build \
    -o /build/gen_test_images \
    ./cmd/gen_test_images

# Build quote_server binary (statically linked)
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -o /build/quote_server \
    ./cmd/quote_server

# Stage 2: Final image
FROM ubuntu:22.04

# Install basic tools, monitoring tools, and WebP library
RUN apt-get update && \
    apt-get install -y \
    curl \
    wget \
    git \
    vim \
    htop \
    iotop \
    net-tools \
    iputils-ping \
    tcpdump \
    strace \
    postgresql-client \
    ca-certificates \
    ufw \
    rsyslog \
    sudo \
    libwebp-dev \
    && rm -rf /var/lib/apt/lists/*

# Install MinIO Client (mc)
RUN wget -q https://dl.min.io/client/mc/release/linux-amd64/mc -O /tmp/mc && \
    chmod +x /tmp/mc && \
    mv /tmp/mc /usr/local/bin/mc && \
    mc --version

# Copy the pre-built binaries
COPY --from=go-builder /build/test_db_perf /usr/local/bin/test_db_perf
COPY --from=go-builder /build/rebuild_db /usr/local/bin/rebuild_db
COPY --from=go-builder /build/gen_test_images /usr/local/bin/gen_test_images
COPY --from=go-builder /build/quote_server /usr/local/bin/quote_server

# Make them executable
RUN chmod +x /usr/local/bin/test_db_perf && \
    chmod +x /usr/local/bin/rebuild_db && \
    chmod +x /usr/local/bin/gen_test_images && \
    chmod +x /usr/local/bin/quote_server

# Create workspace directory
RUN mkdir -p /workspace && chmod 777 /workspace

# Copy rebuild_db data files to workspace (needed for rebuild_db command)
RUN mkdir -p /workspace/rebuild_db
COPY --from=go-builder /build/cmd/rebuild_db/*.json /workspace/rebuild_db/
COPY --from=go-builder /build/schema.sql /workspace/schema.sql

# Set environment variable for rebuild_db data directory
ENV REBUILD_DB_DATA_DIR=/workspace/rebuild_db

# Create non-root jump user with sudo
RUN useradd -m -s /bin/bash jump && \
    echo "jump ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Configure firewall (allow web server)
RUN ufw default deny incoming && \
    ufw default allow outgoing && \
    ufw allow 10000/tcp && \
    echo "y" | ufw enable || true

# Set up command logging/auditing
RUN printf '#!/bin/bash\n\
# Log all commands executed by users\n\
# Use a function to avoid quote escaping issues\n\
log_command() {\n\
    local cmd=$(history 1 | sed "s/^[ ]*[0-9]\\+[ ]*//")\n\
    logger -p local0.info "$(whoami) [$$]: $cmd"\n\
}\n\
export PROMPT_COMMAND="history -a; log_command"\n' > /etc/profile.d/jump-server-audit.sh && \
    chmod +x /etc/profile.d/jump-server-audit.sh

# Configure rsyslog for jump server logging
# Create minimal rsyslog config for Docker (no kernel log, fix permissions)
# Disable imklog in default config (not available in Docker)
RUN sed -i '/imklog/d' /etc/rsyslog.conf && \
    # Override default log destinations to use our custom log file\n\
    sed -i 's|/var/log/syslog|/var/log/jump-server.log|g' /etc/rsyslog.conf && \
    sed -i 's|/var/log/auth.log|/var/log/jump-server.log|g' /etc/rsyslog.conf && \
    sed -i 's|/var/log/mail.log|/var/log/jump-server.log|g' /etc/rsyslog.conf && \
    sed -i 's|/var/log/kern.log|/var/log/jump-server.log|g' /etc/rsyslog.conf && \
    echo '$ActionFileDefaultTemplate RSYSLOG_TraditionalFileFormat\n\
$FileCreateMode 0644\n\
local0.*    /var/log/jump-server.log' > /etc/rsyslog.d/50-jump-server.conf && \
    touch /var/log/jump-server.log && \
    chmod 666 /var/log/jump-server.log && \
    mkdir -p /var/run && \
    chmod 755 /var/log

# Create entrypoint script with logging
RUN echo '#!/bin/bash\n\
set -e\n\
\n\
# Create log files with proper permissions before starting rsyslog\n\
touch /var/log/jump-server.log /var/log/syslog /var/log/auth.log /var/log/mail.log /var/log/kern.log\n\
chmod 666 /var/log/jump-server.log /var/log/syslog /var/log/auth.log /var/log/mail.log /var/log/kern.log\n\
\n\
# Start rsyslog for logging (run in background, no fork for Docker)\n\
# Use -i NONE to prevent pid file issues, run as root for permissions\n\
rsyslogd -n -i NONE -f /etc/rsyslog.conf &\n\
\n\
# Wait a moment for rsyslog to start\n\
sleep 1\n\
\n\
# Log startup\n\
logger -p local0.info "Jump server starting at $(date)"\n\
echo "$(date): Jump server starting" >> /var/log/jump-server.log\n\
\n\
# Start quote server in background\n\
/usr/local/bin/quote_server &\n\
logger -p local0.info "Quote server started on port 10000"\n\
echo "$(date): Quote server started on port 10000" >> /var/log/jump-server.log\n\
\n\
# Keep container running\n\
tail -f /dev/null' > /entrypoint.sh && \
    chmod +x /entrypoint.sh

# Expose web server port
EXPOSE 10000

# Use entrypoint script
ENTRYPOINT ["/entrypoint.sh"]
