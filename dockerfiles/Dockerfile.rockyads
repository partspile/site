# syntax=docker/dockerfile:1

# rockyads.com stand-in: 301 to PUBLIC_SITE_URL.

FROM golang:1.27.3 AS go-builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /rockyads ./cmd/rockyads

FROM cgr.dev/chainguard/static:latest
COPY --from=go-builder /rockyads /rockyads
EXPOSE 10000
ENTRYPOINT ["/rockyads"]
